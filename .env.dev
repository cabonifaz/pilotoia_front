# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Encryption key for remember me functionality
VITE_LOGIN_ENCRYPTION_KEY=pilotoia-login-secret-key

# Environment - controls dev tools visibility
VITE_ENVIRONMENT=development

# Transcription Settings
VITE_TRANSCRIBE_PROVIDER=aws
VITE_SILENCE_THRESHOLD=3000
VITE_INITIAL_SPEECH_TIMEOUT=10000
VITE_TRANSCRIBE_SAMPLE_RATE=16000
VITE_TRANSCRIBE_AUDIO_ENCODING=ogg-opus
VITE_TRANSCRIBE_ENABLE_PARTIAL_RESULTS=true
VITE_TRANSCRIBE_SHOW_SPEAKER_LABEL=false

VITE_POLLING_INTERVAL=30000

VITE_LOGO_URL_BASE=https://fake.com/